rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Job offers — public read so visitors can browse, authenticated admin can write
    match /offresEmploi/{document=**} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Allow public write access to the 'devis' collection
    match /devis/{document=**} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    // Public can submit applications; only authenticated admin can review them
    match /candidatures/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /reclamations/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
